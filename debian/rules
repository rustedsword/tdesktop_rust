#!/usr/bin/make -f
include /usr/share/dpkg/architecture.mk

export CARGO_HOME = $(CURDIR)/debian/cargo
export CARGO_NET_OFFLINE = true

CARGO_PROFILE = \
	--config "profile.release.opt-level=3" \
	--config "profile.release.lto='off'" \
	--config "profile.release.codegen-units=1" \
	--config "profile.release.panic='unwind'"

%:
	dh $@

# patch --forward exits 1 when already applied.
override_dh_auto_configure:
	patch -d wallet-engine -p1 --forward --batch --reject-file=- \
		< debian/patches/wallet-engine.patch \
		|| test $$? -eq 1
	patch -d tlottie -p1 --forward --batch --reject-file=- \
		< debian/patches/tlottie-cpuid-rust-1.93.patch \
		|| test $$? -eq 1

# wallet-engine wants Rust 1.96.1 but builds on resolute's 1.93.1.
override_dh_auto_build:
	cd tdesktop_rust && cargo rustc --offline --locked --ignore-rust-version \
		--lib --release \
		--crate-type staticlib --crate-type cdylib \
		$(CARGO_PROFILE) \
		-- --print native-static-libs
	cd tdesktop_rust && cargo run --offline --locked \
		--manifest-path ../wallet-engine/bindgen/cpp/bindgen/Cargo.toml -- \
		--library --out-dir $(CURDIR)/debian/wallet_engine \
		target/release/libtdesktop_rust.so

# The skipped tests fail on a bare upstream checkout too, see PACKAGING.md.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --offline --locked --release \
		--manifest-path tlottie/Cargo.toml --features c-api -- \
		--skip dos::animated_repeater_product_stays_bounded \
		--skip dos::clipped_dashed_round_join_zigzag_stays_bounded \
		--skip dos::compounding_repeaters_are_rejected \
		--skip dos::nested_track_matte_target_surfaces_stay_bounded \
		--skip dos::renderer_rejects_large_canvas_before_allocating_fallback
endif

override_dh_auto_install:
	install -d debian/libtdesktop-rust-dev/usr/lib/$(DEB_HOST_MULTIARCH)
	objcopy --strip-debug tdesktop_rust/target/release/libtdesktop_rust.a \
		debian/libtdesktop-rust-dev/usr/lib/$(DEB_HOST_MULTIARCH)/libtdesktop_rust.a
	install -D -m 0644 tlottie/include/tlottie.h \
		debian/libtdesktop-rust-dev/usr/include/tlottie/tlottie.h
	install -D -m 0644 -t debian/libtdesktop-rust-dev/usr/include/wallet_engine \
		debian/wallet_engine/*

override_dh_auto_clean:
	rm -rf tdesktop_rust/target tlottie/target \
		wallet-engine/bindgen/cpp/target \
		debian/cargo debian/wallet_engine

# Vendored crates list their Cargo.toml.orig in .cargo-checksum.json.
override_dh_clean:
	dh_clean -XCargo.toml.orig
